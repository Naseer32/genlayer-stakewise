# All values are optional. Leave a value empty if you have not verified it yet.
# Verify every item against the official GenLayer docs / CLI (`genlayer network`, `genlayer staking epoch-info`) first.

VITE_GENLAYER_NETWORK_ID=testnet-asimov
VITE_GENLAYER_NETWORK_LABEL=GenLayer Testnet (Asimov)

# JSON-RPC endpoint used ONLY for a read-only connection check (eth_chainId).
VITE_GENLAYER_RPC_URL=

# Chain ID you verified for that endpoint. If set, a mismatch is reported.
VITE_GENLAYER_CHAIN_ID=

# Staking contract address you verified (shown for reference; no transactions are ever sent).
VITE_GENLAYER_STAKING_ADDRESS=

# Optional: URL of a JSON validator snapshot (same format as the Import panel accepts).
VITE_VALIDATORS_SNAPSHOT_URL=

# Set to "true" only after you verified the values above.
VITE_GENLAYER_CONFIG_VERIFIED=false

# Optional protocol parameters. Leave empty unless verified (see `genlayer staking epoch-info`).
# Reward estimates are shown only when VITE_PARAMS_VERIFIED=true AND both reward rate and commission are set.
VITE_PARAM_MIN_DELEGATION_GEN=
VITE_PARAM_UNBONDING_DAYS=
VITE_PARAM_ANNUAL_REWARD_PERCENT=
VITE_PARAM_VALIDATOR_COMMISSION_PERCENT=
VITE_PARAM_EPOCH_HOURS=
VITE_PARAMS_VERIFIED=false
